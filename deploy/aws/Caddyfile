}
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		root * /srv/shopsmart
		try_files {path} /index.html
		file_server
	}
}
