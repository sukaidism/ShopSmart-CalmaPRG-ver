# Install as /etc/shopsmart/backend.env, root:shopsmart, permissions 640.
# Replace the password with a new generated hexadecimal value matching the application DB role created by setup.sh.
DATABASE_URL='postgresql://shopsmart:REPLACE_WITH_64_HEX_CHARACTERS@YOUR_RDS_ENDPOINT:5432/shopsmart?schema=public&sslmode=require&sslcert=/etc/shopsmart/rds-ca.pem&sslaccept=strict&connection_limit=5'
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://replace-me.duckdns.org
TRUST_PROXY=loopback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
